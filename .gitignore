node_modules
dist
src-tauri/target

# IDE
.idea/

# Local Android SDK path - machine-specific, never commit
local.properties

# Environment variables - never commit
.env
.env.local

# Android signing keys - NEVER commit
*.keystore
*.jks
*.keystore.pw

# Apple provisioning profiles - regenerable, don't commit
*.provisionprofile

# iOS build outputs (the Xcode project itself is committed; ios/.gitignore
# covers the Capacitor-generated files inside it)
build/ios/
*.xcarchive
*.ipa

# Android / Gradle build outputs (android/.gitignore covers the Capacitor
# project's own generated files)
.gradle/
build/
*.aab
*.apk
*.apk.idsig
manifest-checksum.txt
