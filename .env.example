# Copy to .env and fill in. Never commit .env (already gitignored).
# Used for local signed+notarized macOS builds via `pnpm build:mac:signed`,
# and doubles as the source file for `gh secret set -f .env` to bulk-push
# everything to GitHub Actions secrets in one command.

# PostHog project settings. Vite embeds these in the client bundle, so use the
# project API key (phc_...), not a private PostHog personal API key.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

APPLE_SIGNING_IDENTITY=
APPLE_TEAM_ID=
APPLE_ID=
APPLE_PASSWORD=

# CI-only (local builds use the cert already in your Keychain, not these).
# Fill by running: base64 -i /path/to/cert.p12 | pbcopy   then paste below.
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=
